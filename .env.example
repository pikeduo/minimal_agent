# 可选的 API 配置。真实密钥只能保存在未被 Git 跟踪的 .env 文件中。
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地运行文件路径；这些文件均被 Git 忽略。
DATABASE_PATH=data/minimal_agent.sqlite3
TRACE_PATH=logs/agent-trace.jsonl
SERVER_LOG_PATH=logs/server.log

# 登录会话配置。本地 HTTP 开发保持 false；生产 HTTPS 必须设为 true。
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false

# 后续 Agent Runtime 阶段使用的执行限制。
MAX_AGENT_STEPS=8
MAX_CONTEXT_MESSAGES=24
CONTEXT_KEEP_RECENT=12
